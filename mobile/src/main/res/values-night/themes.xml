<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark theme — clinical low-light environment -->
    <style name="Theme.SampleWearMobileApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Clinical blue (lighter for dark mode readability) -->
        <item name="colorPrimary">#FF90CAF9</item>
        <item name="colorPrimaryVariant">@color/clinical_primary_variant</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary: sensor active green (lighter) -->
        <item name="colorSecondary">#FF66BB6A</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Dark surface -->
        <item name="android:statusBarColor">#FF121212</item>
        <!-- Action bar -->
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>
</resources>