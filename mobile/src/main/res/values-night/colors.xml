<?xml version="1.0" encoding="utf-8"?>
<!--
    Night-mode semantic dialog color overrides.
    DRY: only the tokens that DIFFER from light mode are declared here.
    The Android resource system automatically merges these with values/colors.xml.
-->
<resources>
    <!-- Dark surface — Material dark dialog background -->
    <color name="dialog_background">#FF1E1E2E</color>
    <!-- High-contrast white text on dark surface (fully opaque) -->
    <color name="dialog_text">#FFFFFFFF</color>
    <!-- Subdued hint text (70% opacity white) -->
    <color name="dialog_hint">#B3FFFFFF</color>
    <!-- Teal accent button text for night — high contrast on dark -->
    <color name="dialog_button">#FF03DAC5</color>
    <!-- Input text always white in night dialogs -->
    <color name="dialog_input_text">#FFFFFFFF</color>
</resources>
