<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base application theme.
        OCP: extends MaterialComponents.DayNight — never modified, always extended.
    -->
    <style name="Theme.SampleWearMobileApp" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!--
            DRY: alertDialogTheme covers AlertDialog.Builder() calls (AppUtils, MainActivity).
            android:dialogTheme covers EditTextPreference dialogs from the Preference library.
            Both point to the same overlay so all dialogs are styled identically.
        -->
        <item name="alertDialogTheme">@style/AppAlertDialogTheme</item>
        <item name="android:dialogTheme">@style/AppAlertDialogTheme</item>

        <!--
            SRP: preferenceTheme styles only the Preference list rows.
            Required so EditTextPreference dialogs walk up to our dialog theme correctly.
        -->
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.v14.Material</item>
    </style>

    <!--
        AppAlertDialogTheme — Light Mode.
        SRP: owns dialog window appearance only.
        DRY: all color values come from semantic tokens in colors.xml.

        Parent MUST be ThemeOverlay.MaterialComponents.MaterialAlertDialog — this is the
        only parent respected by BOTH AlertDialog.Builder AND EditTextPreference's
        internal dialog builder in the AndroidX Preference library.
    -->
    <style name="AppAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorAccent">@color/purple_500</item>

        <!-- Dialog window surface — explicit white so it never inherits a dark Activity bg -->
        <item name="android:background">@color/dialog_background</item>
        <item name="android:windowBackground">@color/dialog_background</item>

        <!-- Title + body text — high-contrast dark text on white dialog -->
        <item name="android:textColorPrimary">@color/dialog_text</item>
        <item name="android:textColorSecondary">@color/dialog_hint</item>
        <item name="android:textColor">@color/dialog_text</item>

        <!-- Input text inside EditText/TextInputEditText inside the dialog -->
        <item name="android:editTextColor">@color/dialog_input_text</item>

        <!--
            DRY: one DialogButtonStyle applied to all three button slots.
            This is what makes OK / Cancel / Neutral text visible.
        -->
        <item name="buttonBarPositiveButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DialogButtonStyle</item>
        <item name="buttonBarNeutralButtonStyle">@style/DialogButtonStyle</item>
    </style>

    <!--
        DialogButtonStyle — Light Mode.
        SRP: owns only button text appearance.
        DRY: reused for all three button slots via AppAlertDialogTheme.
        Responsive: 48dp minHeight meets WCAG 2.1 AA touch-target requirement.
    -->
    <style name="DialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/dialog_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
    </style>

    <!--
        InverseTheme — used by AlertDialog.Builder(ctx, R.style.InverseTheme) calls
        in AppUtils and MainActivity.
        OCP: inherits ALL fixes from AppAlertDialogTheme — any future change to
        AppAlertDialogTheme automatically propagates here.
    -->
    <style name="InverseTheme" parent="AppAlertDialogTheme">
        <!-- No overrides needed — inherits everything from AppAlertDialogTheme -->
    </style>

</resources>