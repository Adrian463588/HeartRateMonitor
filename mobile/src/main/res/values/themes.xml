<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme — updated to M3 for Compose interop -->
    <style name="Theme.SampleWearMobileApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Clinical blue primary -->
        <item name="colorPrimary">@color/clinical_primary</item>
        <item name="colorPrimaryVariant">@color/clinical_primary_variant</item>
        <item name="colorOnPrimary">@color/clinical_on_primary</item>
        <!-- Secondary: sensor active green -->
        <item name="colorSecondary">@color/sensor_active</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@color/clinical_primary</item>
        <!-- Action bar (toolbar) -->
        <item name="windowActionBar">true</item>
        <item name="windowNoTitle">false</item>
    </style>

    <style name="InverseTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorPrimary">@color/white</item>
        <item name="colorAccent">@color/clinical_primary</item>
    </style>
</resources>